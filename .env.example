# Copy to .env and fill in locally. Never commit .env.

# OpenAI (used by matching, drafting and notebook structuring)
OPENAI_API_KEY=
# Optional: overrides the matching model (default gpt-5-mini)
OPENAI_MODEL=

# Grant discovery: a contact (email or web address) included in the fetcher's user agent so source sites can reach you
GRANT_PLATFORM_CONTACT=

# Email delivery. OFF unless EMAIL_DELIVERY=smtp AND every setting below is filled in; until then messages are only
# written to instance/outbox/. EMAIL_ALLOWLIST (comma-separated addresses or domains) limits who can ever be emailed.
# Provider set-up belongs to Phase 4. Never put real values in this example file.
EMAIL_DELIVERY=
EMAIL_FROM=
EMAIL_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# PI workspace private pilot access
# PILOT_MODE=1 turns on tester login; PILOT_USERS_JSON maps tester names to access-code hashes
PILOT_MODE=
PILOT_USERS_JSON=
# Folder where per-tester workspaces are stored
WORKSPACE_STORAGE_ROOT=
